{
  "name": "@pedropacheco95/cortex",
  "version": "1.0.0",
  "description": "A globally-installed Node.js CLI for Claude Code that builds and maintains a persistent, actively-refreshed knowledge layer (.cortex/) linking a codebase's structure, conventions, specs, tests, and runtime scaffolding.",
  "type": "module",
  "license": "MIT",
  "author": "Pedro Pacheco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedropacheco95/cortex.git"
  },
  "bugs": {
    "url": "https://github.com/pedropacheco95/cortex/issues"
  },
  "homepage": "https://github.com/pedropacheco95/cortex#readme",
  "keywords": [
    "claude-code",
    "codebase-understanding",
    "knowledge-graph",
    "cli",
    "spec-driven",
    "tree-sitter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:atomic": "vitest run tests/atomic",
    "test:spec": "vitest run tests/spec",
    "dev": "node dist/cli/cli.js",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "ignore": "5.3.2",
    "picomatch": "^2.3.2",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/picomatch": "^2.3.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "bin": {
    "cortex": "dist/cli/cli.js"
  }
}
